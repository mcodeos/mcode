#!/bin/bash
# Header law (CLAUDE.md): every tracked .mc opens with the exact 2-line
# MCode Bench(TM) provenance template. Nothing may precede it.
set -u
cd "$(dirname "$0")/.."
line1='# Copyright (c) 2026 MCode. Built with MCode Bench(TM).'
line2='# Licensed under the Apache License, Version 2.0.'
bad=0
while IFS= read -r f; do
    actual=$(head -2 "$f")
    if [ "$actual" != "$line1
$line2" ]; then
        echo "FAIL header: $f"
        bad=1
    fi
done < <(git ls-files '*.mc')
if [ "$bad" -ne 0 ]; then
    echo "pre-commit: header law violated (see CLAUDE.md)"
    exit 1
fi

# No document page/section references (CLAUDE.md): evidence trails like
# `p.27`, `pp.1/25`, `Table 5-1` live in the packs, never in this repo.
pagebad=0
while IFS= read -r f; do
    case "$f" in */libs/*|CLAUDE.md|README.md) continue ;; esac
    [ -f "$f" ] || continue
    if grep -nEi '(^|[^a-zA-Z0-9])pp?\.[ ]?[0-9]+' "$f" >/dev/null 2>&1; then
        grep -nEi '(^|[^a-zA-Z0-9])pp?\.[ ]?[0-9]+' "$f" | sed "s|^|FAIL pageref: $f:|"
        pagebad=1
    fi
done < <(git ls-files '*.mc' '*.toml' '*.md')
if [ "$pagebad" -ne 0 ]; then
    echo "pre-commit: document page references found (see CLAUDE.md)"
    exit 1
fi

# No cross-repo or internal-design references (CLAUDE.md): no sibling-repo
# mentions, no issue/decision numbers, no design-clause ("ruling N") or
# witness IDs, no pointers into design docs (.md/.rs).
refbad=0
while IFS= read -r f; do
    case "$f" in */libs/*|CLAUDE.md|README.md) continue ;; esac
    [ -f "$f" ] || continue
    if grep -nE 'mcparts|\bmcfam\b|\bmcd\b|\bb[0-9]{4}\b|\brulings?[ -]?[0-9]+|§|\bU[0-9]{3}\b|[a-zA-Z0-9_-]+\.(md|rs)\b' "$f" >/dev/null 2>&1; then
        grep -nE 'mcparts|\bmcfam\b|\bmcd\b|\bb[0-9]{4}\b|\brulings?[ -]?[0-9]+|§|\bU[0-9]{3}\b|[a-zA-Z0-9_-]+\.(md|rs)\b' "$f" | sed "s|^|FAIL ref: $f:|"
        refbad=1
    fi
done < <(git ls-files '*.mc' '*.toml' '*.md')
if [ "$refbad" -ne 0 ]; then
    echo "pre-commit: cross-repo / internal-design references found (see CLAUDE.md)"
    exit 1
fi

# Enum-group gate: the group metadata must agree with the enum it groups and
# with the assignments the library writes (no cross-group assignment).  A
# group file that drifts is a judgement nobody enforces.
if ! python3 scripts/check-enum-groups.py; then
    echo "pre-commit: enum group gate failed (see scripts/check-enum-groups.py)"
    exit 1
fi

# Pin-face gate: the library face keeps the shapes that landed (usage
# blocks, pin naming off the pin number).  A gate nobody calls is a gate
# that never bites, so it is called here.
if ! python3 scripts/check-face.py --quiet; then
    echo "pre-commit: pin-face gate failed (see scripts/check-face.py)"
    exit 1
fi

# Spec-key vocabulary gate: one quantity, one spelling.
if ! python3 scripts/check-spec-keys.py; then
    echo "pre-commit: spec-key gate failed (see scripts/check-spec-keys.py)"
    exit 1
fi
