// SDIO - Secure Digital I/O Card Interface (4-bit) Standard Definition
// Core Rule: Six wires: a host-sourced clock, one bidirectional
//            command/response line (CMD), and four bidirectional data
//            lines (DAT3 doubles as card select in the SPI mode).
//            3.3V default, 1.8V in the UHS modes.
// Device Definition: HOST = MCU/SoC SD host controller,
//                    CARD = SD memory or SDIO peripheral card.

interface SDIO(role)
{
    topology = "point to point"
    mode = ["half duplex", "full duplex"]  // 1-bit / 4-bit modes
    // Electrical contract data rides the recipe face: ELEC.SDIO carries the
    // bus link contract (supply window, per-part bus clock over the mode
    // set, the S18 1.8 V signaling switch, the CMD/DAT pull-up class) --
    // the SD/SDIO simplified specifications are in the corpus. The
    // signal-level and bus-capacitance faces are deliberate blanks in the
    // simplified specs (zero numeric witnesses in the tree; gap ledger).
    // The retired distance row (0.1 m, PCB trace only) was folklore -- its
    // own comment was the only witness; the rate-at-distance spellings
    // were folklore forms of the per-mode clock. Supply tiers ride the DC
    // faces; the 1.8 V UHS-I tier rides the book's switch flag.

    pins = [
        1 = CLK @class(digital), "Clock"             // Clock signal, generated by host
        2 = CMD @class(digital), "Command"           // Bidirectional command/response line
        3 = DAT0 @class(digital), "Data 0"           // Bidirectional data line 0
        4 = DAT1 @class(digital), "Data 1"           // Bidirectional data line 1
        5 = DAT2 @class(digital), "Data 2"           // Bidirectional data line 2
        6 = DAT3, "Data 3"           // Bidirectional data line 3 (also CS in SPI mode)
    ]

    role HOST {  // SDIO Host (MCU/SoC)
        name = "SDIO Host"
        pins = [
            out 1 = CLK @class(digital), "Clock"     // The host sources the clock
            io 2 = CMD @class(digital), "Command"    // Command out, response in — either side drives
            io 3 = DAT0 @class(digital), "Data 0"    // Bidirectional data line 0
            io 4 = DAT1 @class(digital), "Data 1"    // Bidirectional data line 1
            io 5 = DAT2 @class(digital), "Data 2"    // Bidirectional data line 2
            io 6 = DAT3, "Data 3"    // Bidirectional data line 3 (also CS in SPI mode)
        ]
        peer = CARD
    }
    role CARD {  // SDIO Card (SD card / SDIO peripheral)
        name = "SDIO Card"
        pins = [
            in 1 = CLK @class(digital), "Clock"      // The clock is an input on the card side
            io 2 = CMD @class(digital), "Command"    // Command out, response in — either side drives
            io 3 = DAT0 @class(digital), "Data 0"    // Bidirectional data line 0
            io 4 = DAT1 @class(digital), "Data 1"    // Bidirectional data line 1
            io 5 = DAT2 @class(digital), "Data 2"    // Bidirectional data line 2
            io 6 = DAT3, "Data 3"    // Bidirectional data line 3 (also CS in SPI mode)
        ]
        peer = HOST
    }
}

// SDIO.1 - Secure Digital I/O Card Interface (1-bit bus) Standard Definition
// Core Rule: The 1-bit SD mode — clock, CMD, and a single data line, the
//            fallback when fewer data lines are available.
// Device Definition: HOST = MCU/SoC SD host controller,
//                    CARD = SD memory or SDIO peripheral card.

interface SDIO.1(role)
{
    topology = "point to point"
    mode = ["half duplex"]
    // Variant rider of ELEC.SDIO: the 1-bit mode is the same link contract
    // over fewer data lines (CLK/CMD/DAT0); the book serves both faces.
    // The retired envelope rows share the 4-bit face's corpus verdict.

    pins = [
        1 = CLK @class(digital), "Clock"             // Clock signal
        2 = CMD @class(digital), "Command"           // Bidirectional command/response line
        3 = DAT0 @class(digital), "Data 0"           // Bidirectional data line
    ]

    role HOST {
        name = "SDIO Host"
        pins = [
            out 1 = CLK @class(digital), "Clock"   // The host sources the clock
            io 2 = CMD @class(digital), "Command"  // Command out, response in — either side drives
            io 3 = DAT0 @class(digital), "Data 0"  // Bidirectional data line
        ]
        peer = CARD
    }
    role CARD {
        name = "SDIO Card"
        pins = [
            in 1 = CLK @class(digital), "Clock"    // The clock is an input on the card side
            io 2 = CMD @class(digital), "Command"  // Command out, response in — either side drives
            io 3 = DAT0 @class(digital), "Data 0"  // Bidirectional data line
        ]
        peer = HOST
    }
}
