#!/bin/bash
# Header law (CLAUDE.md): every tracked .mc opens with the exact 2-line
# MCode Bench(TM) provenance template. Nothing may precede it.
set -u
cd "$(dirname "$0")/.."
line1='# Copyright (c) 2026 MCode. Built with MCode Bench(TM).'
line2='# Licensed under the Apache License, Version 2.0.'
bad=0
while IFS= read -r f; do
    actual=$(head -2 "$f")
    if [ "$actual" != "$line1
$line2" ]; then
        echo "FAIL header: $f"
        bad=1
    fi
done < <(git ls-files '*.mc')
if [ "$bad" -ne 0 ]; then
    echo "pre-commit: header law violated (see CLAUDE.md)"
    exit 1
fi
